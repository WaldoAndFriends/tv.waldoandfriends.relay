          "en": "A new episode is released"
        },
        "titleFormatted": {
          "en": "A new episode of [[show]] is released"
        },
        "hint": {
          "en": "Triggers when a new Relay.fm podcast episode is published"
        },
        "tokens": [
          {
            "name": "episode_title",
            "type": "string",
            "title": {
              "en": "Episode Title"
            },
            "example": "178: The Process of Investigative Reporting"
          },
          {
            "name": "episode_url",
            "type": "string",
            "title": {
              "en": "Episode URL"
            },
            "example": "https://www.relay.fm/cortex/178"
          },
          {
            "name": "episode_media_url",
            "type": "string",
            "title": {
              "en": "Media URL"
            },
            "example": "https://traffic.libsyn.com/cortex/Cortex_178.mp3"
          },
          {
            "name": "show_name",
            "type": "string",
            "title": {
              "en": "Show Name"
            },
            "example": "Cortex"
          },
          {
            "name": "show_slug",
            "type": "string",
            "title": {
              "en": "Show Slug"
            },
            "example": "cortex"
          },
          {
            "name": "episode_number",
            "type": "number",
            "title": {
              "en": "Episode Number"
            },
            "example": 178
          },
          {
            "name": "episode_subtitle",
            "type": "string",
            "title": {
              "en": "Episode Subtitle"
            },
            "example": "Myke talks to Jason Schreier about..."
          },
          {
            "name": "episode_duration",
            "type": "number",
            "title": {
              "en": "Duration (seconds)"
            },
            "example": 3664
          },
          {
            "name": "episode_published",
            "type": "string",
            "title": {
              "en": "Published Date"
            },
            "example": "Mon, 27 Apr 2026 11:30:00 GMT"
          }
